{
  "multipart": [
    { "when": { "down": true },  "apply": { "model": "bmu:block/camo_net" } },
    { "when": { "up": true },    "apply": { "model": "bmu:block/camo_net", "x": 180 } },
    { "when": { "north": true }, "apply": { "model": "bmu:block/camo_net", "x": 270 } },
    { "when": { "south": true }, "apply": { "model": "bmu:block/camo_net", "x": 270, "y": 180 } },
    { "when": { "east": true },  "apply": { "model": "bmu:block/camo_net", "x": 270, "y": 90 } },
    { "when": { "west": true },  "apply": { "model": "bmu:block/camo_net", "x": 270, "y": 270 } }
  ]
}