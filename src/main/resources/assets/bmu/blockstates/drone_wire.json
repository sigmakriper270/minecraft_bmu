{
  "multipart": [
    { "when": { "axis": "x" }, "apply": { "model": "bmu:block/drone_wire" } },
    { "when": { "axis": "z" }, "apply": { "model": "bmu:block/drone_wire", "y": 90 } },

    { "when": { "axis": "x", "north": "true" }, "apply": { "model": "bmu:block/drone_wire_connector" } },
    { "when": { "axis": "x", "south": "true" }, "apply": { "model": "bmu:block/drone_wire_connector", "y": 180 } },
    { "when": { "axis": "z", "east":  "true" }, "apply": { "model": "bmu:block/drone_wire_connector", "y": 90 } },
    { "when": { "axis": "z", "west":  "true" }, "apply": { "model": "bmu:block/drone_wire_connector", "y": 270 } }
  ]
}